        <mxCell id="lg4tx" parent="legend" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Request / Response&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#667788&#39; style=&#39;font-size:10px&#39;&gt;HTTPS, client ↔ server&lt;/font&gt;" vertex="1">
