        <mxCell id="note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;spacingRight=14;fontSize=13;fontColor=#5c4a1a;arcSize=6;" value="&lt;b&gt;Note&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;FinZen has no remote backend/API — this deliverable is a client-only SPA. It is deployed as static files (Vue build output) served by nginx inside a Docker container on a single GCP Compute Engine VM. After the initial page load, all business logic runs in the browser; the only persistence is the browser&#39;s localStorage, via Pinia.&lt;/font&gt;" vertex="1">
          <mxGeometry height="160" width="340" x="20" y="750" as="geometry" />
        </mxCell>
