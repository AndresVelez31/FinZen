# Dependencies
/node_modules

# dist/ is intentionally tracked: the Dockerfile copies the pre-built dist/
# straight into the image (Tutorial 08), so the VM never needs to build it.

# SQLite database (created on first start)
*.sqlite

# Environment variables
.env
.env.*
!.env.example

# Logs
*.log

# Tests
/coverage

# TypeScript incremental build info
*.tsbuildinfo
